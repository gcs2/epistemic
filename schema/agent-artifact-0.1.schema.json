{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ses:schema:agent-artifact:0.1",
  "title": "SES Agent Artifact Envelope 0.1",
  "type": "object",
  "required": [
    "artifact_id",
    "inquiry_id",
    "role",
    "producer",
    "created_at",
    "parents",
    "claims",
    "sources",
    "uncertainties",
    "conflicts"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "inquiry_id": {"type": "string", "minLength": 1},
    "role": {
      "enum": [
        "framer",
        "evidence_scout",
        "provenance_mapper",
        "model_advocate",
        "translator",
        "causal_modeler",
        "methodologist",
        "skeptic",
        "stakeholder_steward",
        "synthesizer",
        "auditor"
      ]
    },
    "producer": {
      "type": "object",
      "required": ["system", "configuration_hash", "operator"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "configuration_hash": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "institution": {"type": "string"},
        "model_family": {"type": "string"}
      },
      "additionalProperties": true
    },
    "created_at": {"type": "string", "format": "date-time"},
    "parents": {
      "type": "array",
      "items": {"type": "string"}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "confidence", "basis"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "basis": {"type": "array", "items": {"type": "string"}},
          "targets": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator", "accessed_at", "source_hash"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "accessed_at": {"type": "string", "format": "date-time"},
          "source_hash": {"type": "string", "minLength": 1},
          "proposed_dependence_group": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": "string"}
  },
  "additionalProperties": false
}
