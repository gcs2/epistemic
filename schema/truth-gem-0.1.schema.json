{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ses:schema:truth-gem:0.1",
  "title": "SES Truth Gem 0.1",
  "type": "object",
  "required": [
    "id",
    "claim",
    "type",
    "status",
    "scope",
    "support",
    "confidence",
    "invariance",
    "boundary",
    "disconfirmation",
    "action_implication",
    "portability",
    "version"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "invariant",
        "mechanism",
        "threshold",
        "boundary",
        "bridge",
        "decision",
        "ignorance",
        "question"
      ]
    },
    "status": {
      "enum": ["conjecture", "candidate", "synthetic_confirmed", "replicated", "retired"]
    },
    "scope": {"type": "string", "minLength": 1},
    "support": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {
      "type": "object",
      "required": ["level", "rationale"],
      "properties": {
        "level": {"enum": ["low", "moderate", "high", "very_high"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "invariance": {
      "type": "array",
      "items": {"type": "string"}
    },
    "boundary": {"type": "string", "minLength": 1},
    "disconfirmation": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "action_implication": {"type": "string", "minLength": 1},
    "portability": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version": {
      "type": "object",
      "required": ["number", "date", "evidence_cutoff", "source_experiment"],
      "properties": {
        "number": {"type": "string"},
        "date": {"type": "string"},
        "evidence_cutoff": {"type": "string"},
        "source_experiment": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
